# main.py
import os
import threading
import traceback
import customtkinter as ctk
from tkinter import filedialog

from ai_analysis import analyze_gameplay, verify_is_mlbb_gameplay
from screen_recorder import ScreenRecorder

ctk.set_appearance_mode("dark")
ctk.set_default_color_theme("blue")


class MLGuideMobileApp(ctk.CTk):

    def __init__(self):
        super().__init__()

        self.title("ML AI Guide Mobile")
        self.geometry("390x810")
        self.resizable(False, False)
        self.configure(fg_color="#071426")

        self.recorder = ScreenRecorder()

        self.grid_rowconfigure(0, weight=0)
        self.grid_rowconfigure(1, weight=1)
        self.grid_rowconfigure(2, weight=0)
        self.grid_columnconfigure(0, weight=1)

        self.create_top_bar()
        self.create_bottom_nav()
        self.open_home()

    def create_top_bar(self):
        self.top_bar = ctk.CTkFrame(self, height=55, corner_radius=0, fg_color="#0B1930")
        self.top_bar.grid(row=0, column=0, sticky="ew")
        self.top_bar.grid_propagate(False)

        ctk.CTkLabel(
            self.top_bar,
            text="⚔ ML AI GUIDE",
            font=("Arial", 16, "bold"),
            text_color="#58C7FF"
        ).pack(side="left", padx=16, pady=12)

        ctk.CTkLabel(
            self.top_bar,
            text="MOBILE",
            font=("Arial", 10, "bold"),
            text_color="#8EA6C7",
            fg_color="#10213B",
            corner_radius=6,
            padx=6,
            pady=2
        ).pack(side="right", padx=16)

    def create_bottom_nav(self):
        self.bottom_nav = ctk.CTkFrame(self, height=65, corner_radius=0, fg_color="#0B1930")
        self.bottom_nav.grid(row=2, column=0, sticky="ew")
        self.bottom_nav.grid_propagate(False)
        self.bottom_nav.grid_columnconfigure((0, 1, 2, 3), weight=1)

        self.btn_nav_home = ctk.CTkButton(
            self.bottom_nav,
            text="🏠\nHome",
            font=("Arial", 10),
            fg_color="transparent",
            hover_color="#10213B",
            text_color="#8EA6C7",
            command=self.open_home
        )
        self.btn_nav_home.grid(row=0, column=0, sticky="nsew", pady=4)

        self.btn_nav_analyze = ctk.CTkButton(
            self.bottom_nav,
            text="⚔️\nAnalyze",
            font=("Arial", 10, "bold"),
            fg_color="transparent",
            hover_color="#10213B",
            text_color="#8EA6C7",
            command=self.open_analysis
        )
        self.btn_nav_analyze.grid(row=0, column=1, sticky="nsew", pady=4)

        self.btn_nav_assess = ctk.CTkButton(
            self.bottom_nav,
            text="🎯\nAssess",
            font=("Arial", 10),
            fg_color="transparent",
            hover_color="#10213B",
            text_color="#8EA6C7",
            command=self.open_assessment
        )
        self.btn_nav_assess.grid(row=0, column=2, sticky="nsew", pady=4)

        self.btn_nav_history = ctk.CTkButton(
            self.bottom_nav,
            text="📊\nHistory",
            font=("Arial", 10),
            fg_color="transparent",
            hover_color="#10213B",
            text_color="#8EA6C7",
            command=self.open_history
        )
        self.btn_nav_history.grid(row=0, column=3, sticky="nsew", pady=4)

    def set_active_nav(self, active_btn):
        for btn in (self.btn_nav_home, self.btn_nav_analyze, self.btn_nav_assess, self.btn_nav_history):
            btn.configure(text_color="#8EA6C7")
        active_btn.configure(text_color="#58C7FF")

    def clear_content(self):
        if hasattr(self, "content"):
            self.content.destroy()

        self.content = ctk.CTkScrollableFrame(self, fg_color="transparent")
        self.content.grid(row=1, column=0, sticky="nsew", padx=12, pady=8)
        self.content.grid_columnconfigure(0, weight=1)

    def open_home(self):
        self.set_active_nav(self.btn_nav_home)
        self.clear_content()

        ctk.CTkLabel(
            self.content,
            text="Welcome Back,",
            font=("Arial", 14),
            text_color="#8EA6C7"
        ).pack(anchor="w", pady=(10, 0))

        ctk.CTkLabel(
            self.content,
            text="ML AI GUIDE",
            font=("Arial", 22, "bold"),
            text_color="#FFFFFF"
        ).pack(anchor="w", pady=(0, 15))

        hero_card = ctk.CTkFrame(
            self.content, corner_radius=16, fg_color="#142C50", border_width=1, border_color="#2676BC"
        )
        hero_card.pack(fill="x", pady=5)

        ctk.CTkLabel(
            hero_card, text="LEVEL UP GAMEPLAY", font=("Arial", 16, "bold"), text_color="#66D3FF"
        ).pack(anchor="w", padx=16, pady=(16, 6))

        ctk.CTkLabel(
            hero_card,
            text="Run local TensorFlow MobileNetV2 computer vision models to evaluate your matches.",
            font=("Arial", 12),
            text_color="#E3ECFA",
            wraplength=320,
            justify="left",
        ).pack(anchor="w", padx=16, pady=2)

        ctk.CTkButton(
            hero_card,
            text="Start Analysis  →",
            height=40,
            corner_radius=8,
            fg_color="#356DFF",
            hover_color="#254FD1",
            font=("Arial", 13, "bold"),
            command=self.open_analysis,
        ).pack(fill="x", padx=16, pady=(14, 16))

        ctk.CTkLabel(
            self.content, text="QUICK ACTIONS", font=("Arial", 14, "bold"), text_color="#FFFFFF"
        ).pack(anchor="w", pady=(20, 8))

        self.create_mobile_card("⚔️ Analyze Match", "Record or upload gameplay video clip.", self.open_analysis)
        self.create_mobile_card("🎯 Role Assessment", "Test scenario decisions using local clips.", self.open_assessment)
        self.create_mobile_card("📜 Match History", "Review previous AI coaching reports.", self.open_history)

    def create_mobile_card(self, title, description, command):
        card = ctk.CTkFrame(
            self.content, corner_radius=12, fg_color="#10213B", border_width=1, border_color="#233D60"
        )
        card.pack(fill="x", pady=5)

        ctk.CTkLabel(card, text=title, font=("Arial", 14, "bold"), text_color="#FFFFFF").pack(
            anchor="w", padx=14, pady=(12, 2)
        )

        ctk.CTkLabel(
            card, text=description, font=("Arial", 11), text_color="#A7B9D4", wraplength=320, justify="left"
        ).pack(anchor="w", padx=14, pady=(0, 10))

        card.bind("<Button-1>", lambda e: command())

    def open_analysis(self):
        self.set_active_nav(self.btn_nav_analyze)
        self.clear_content()

        ctk.CTkLabel(
            self.content, text="AI MATCH ANALYSIS", font=("Arial", 20, "bold"), text_color="#FFFFFF"
        ).pack(anchor="w", pady=(10, 10))

        self.analysis_box = ctk.CTkFrame(
            self.content, corner_radius=14, fg_color="#10213B", border_width=1, border_color="#233D60"
        )
        self.analysis_box.pack(fill="x", pady=5, ipady=10)

        self.status_label = ctk.CTkLabel(
            self.analysis_box,
            text="Record screen during gameplay or upload an MLBB .mp4 video clip.",
            font=("Arial", 12),
            text_color="#A7B9D4",
            wraplength=320,
            justify="center",
        )
        self.status_label.pack(pady=(12, 12), padx=14)

        self.record_btn = ctk.CTkButton(
            self.analysis_box,
            text="🔴 Start Screen Recording",
            height=44,
            font=("Arial", 13, "bold"),
            fg_color="#D32F2F",
            hover_color="#9A0007",
            command=self.toggle_recording,
        )
        self.record_btn.pack(fill="x", padx=14, pady=4)

        self.upload_btn = ctk.CTkButton(
            self.analysis_box,
            text="📁 Upload Video File (.mp4)",
            height=44,
            font=("Arial", 13, "bold"),
            fg_color="#356DFF",
            hover_color="#254FD1",
            command=self.select_video_file,
        )
        self.upload_btn.pack(fill="x", padx=14, pady=(4, 10))

        self.results_frame = ctk.CTkFrame(self.content, fg_color="transparent")
        self.results_frame.pack(fill="x", pady=10)

    def toggle_recording(self):
        if not self.recorder.is_recording:
            if os.path.exists(self.recorder.output_filename):
                try:
                    os.remove(self.recorder.output_filename)
                except Exception:
                    pass

            self.recorder.start_recording()
            self.record_btn.configure(text="⏹️ Stop & Analyze Match", fg_color="#FF8800", hover_color="#CC6600")
            self.upload_btn.configure(state="disabled")
            self.status_label.configure(
                text="🎥 Recording screen... Play your match now! Tap 'Stop & Analyze' when finished.",
                text_color="#66D3FF",
            )
        else:
            self.record_btn.configure(state="disabled")
            self.status_label.configure(
                text="⏳ Stopping recording and verifying clip...",
                text_color="#FFCC00",
            )
            video_file = self.recorder.stop_recording()
            self.start_ai_pipeline(video_file)

    def select_video_file(self):
        file_path = filedialog.askopenfilename(
            title="Select Match Recording",
            filetypes=[("MP4 Video Files", "*.mp4"), ("All Video Files", "*.mp4 *.mov *.avi *.mkv")]
        )
        if file_path:
            self.start_ai_pipeline(file_path)

    def start_ai_pipeline(self, video_path):
        # 1. UI Validation Check: Missing input or empty file
        if not video_path or not os.path.exists(video_path) or os.path.getsize(video_path) == 0:
            self._show_ui_alert("⚠️ Missing Input Video\nNo video file provided or recording is empty.")
            self._reset_ui_state()
            return

        # 2. UI Validation Check: Invalid gameplay or short clip
        is_valid, err_msg = verify_is_mlbb_gameplay(video_path)
        if not is_valid:
            self._show_ui_alert(f"❌ Analysis Blocked\n{err_msg}")
            self._reset_ui_state()
            return

        # Passed validation
        self.upload_btn.configure(state="disabled")
        self.record_btn.configure(state="disabled")
        self.status_label.configure(
            text="⏳ Valid MLBB clip detected. Running MobileNetV2 inference...",
            text_color="#66D3FF",
        )

        threading.Thread(
            target=self._run_analysis_thread, args=(video_path,), daemon=True
        ).start()

    def _show_ui_alert(self, message):
        """Displays an in-app error/warning box inside the UI instead of a system popup."""
        for widget in self.results_frame.winfo_children():
            widget.destroy()

        alert_card = ctk.CTkFrame(self.results_frame, fg_color="#3B1414", corner_radius=10, border_width=1, border_color="#FF5555")
        alert_card.pack(fill="x", pady=6)

        ctk.CTkLabel(
            alert_card,
            text=message,
            font=("Arial", 11, "bold"),
            text_color="#FF8888",
            wraplength=310,
            justify="left",
        ).pack(anchor="w", padx=12, pady=12)

    def _reset_ui_state(self):
        self.upload_btn.configure(state="normal")
        self.record_btn.configure(
            text="🔴 Start Screen Recording",
            fg_color="#D32F2F",
            hover_color="#9A0007",
            state="normal",
        )
        self.status_label.configure(
            text="Record screen during gameplay or upload an MLBB .mp4 video clip.",
            text_color="#A7B9D4",
        )

    def _run_analysis_thread(self, video_path):
        try:
            results = analyze_gameplay(video_path)
            self.after(0, self._display_analysis_results, results)
        except Exception as e:
            traceback.print_exc()
            self.after(0, self._handle_analysis_error, str(e))

    def _display_analysis_results(self, results):
        self._reset_ui_state()
        self.status_label.configure(text="✅ MobileNetV2 Analysis Complete!", text_color="#55FF55")

        for widget in self.results_frame.winfo_children():
            widget.destroy()

        summary_text = results.get("summary", "No summary provided.")
        summary_card = ctk.CTkFrame(self.results_frame, fg_color="#142C50", corner_radius=10)
        summary_card.pack(fill="x", pady=6)

        ctk.CTkLabel(
            summary_card, text="KERAS EVALUATION", font=("Arial", 14, "bold"), text_color="#66D3FF"
        ).pack(anchor="w", padx=12, pady=(10, 4))

        ctk.CTkLabel(
            summary_card,
            text=summary_text,
            font=("Arial", 11),
            text_color="#E3ECFA",
            wraplength=310,
            justify="left",
        ).pack(anchor="w", padx=12, pady=(0, 10))

        keypoints = results.get("keypoints", [])
        for kp in keypoints:
            card = ctk.CTkFrame(self.results_frame, fg_color="#10213B", corner_radius=8)
            card.pack(fill="x", pady=4)

            timestamp = kp.get("timestamp", "00:00")
            obs = kp.get("observed_action", "")
            advice = kp.get("how_to_improve", "")

            ctk.CTkLabel(
                card, text=f"⏱ Timestamp: {timestamp}", font=("Arial", 12, "bold"), text_color="#58C7FF"
            ).pack(anchor="w", padx=10, pady=(8, 2))

            ctk.CTkLabel(
                card,
                text=f"Detection: {obs}",
                font=("Arial", 11),
                text_color="#FFFFFF",
                wraplength=310,
                justify="left",
            ).pack(anchor="w", padx=10, pady=2)

            ctk.CTkLabel(
                card,
                text=f"Recommendation: {advice}",
                font=("Arial", 11, "italic"),
                text_color="#A7B9D4",
                wraplength=310,
                justify="left",
            ).pack(anchor="w", padx=10, pady=(2, 8))

    def _handle_analysis_error(self, error_message):
        self._reset_ui_state()
        self.status_label.configure(text="❌ Analysis aborted.", text_color="#FF5555")
        self._show_ui_alert(f"❌ Analysis Error\n{error_message}")

