                    "question": "Before an important teamfight, what is the most critical duty of the Roamer?",
                    "options": [
                        "A) Hide behind the Marksman",
                        "B) Check and clear face-check bushes to establish vision control and prevent ambushes",
                        "C) Clear minion waves in mid lane",
                        "D) Stay in base shopping"
                    ],
                    "answer": 1
                },
                {
                    "question": "Your team wins a teamfight and takes down 3 enemy heroes. As the Roamer, what call should you prioritize?",
                    "options": [
                        "A) Return to base to heal full health",
                        "B) Ping and lead your team directly to push a tower or take the Lord/Turtle objective",
                        "C) Hit small jungle creeps",
                        "D) Chase the remaining 2 enemies across the entire map"
                    ],
                    "answer": 1
                }
            ]
        }

        # Clean the role title for dictionary lookup
        self.selected_role_name = role_title
        self.quiz_questions = role_banks.get(role_title, role_banks["🔮 Mid Lane"])
        self.current_q_idx = 0
        self.user_score = 0
        self.render_quiz_question()

    def render_quiz_question(self):
        self.clear_content()

        q_data = self.quiz_questions[self.current_q_idx]
        total_q = len(self.quiz_questions)

        ctk.CTkLabel(
            self.content,
            text=f"{self.selected_role_name.upper()} • QUESTION {self.current_q_idx + 1} OF {total_q}",
            font=("Arial", 11, "bold"),
            text_color="#58C7FF"
        ).pack(anchor="w", pady=(10, 2))

        q_card = ctk.CTkFrame(self.content, fg_color="#142C50", corner_radius=12, border_width=1, border_color="#2676BC")
        q_card.pack(fill="x", pady=5)

        ctk.CTkLabel(
            q_card,
            text=q_data["question"],
            font=("Arial", 12),
            text_color="#E3ECFA",
            wraplength=310,
            justify="left"
        ).pack(anchor="w", padx=16, pady=16)

        self.selected_option_var = ctk.IntVar(value=-1)

        for idx, option_text in enumerate(q_data["options"]):
            rb = ctk.CTkRadioButton(
                self.content,
                text=option_text,
                variable=self.selected_option_var,
                value=idx,
                font=("Arial", 11),
                text_color="#FFFFFF",
                fg_color="#356DFF",
                hover_color="#254FD1"
            )
            rb.pack(anchor="w", padx=8, pady=6)

        ctk.CTkButton(
            self.content,
            text="Confirm Answer  →",
            height=42,
            corner_radius=8,
            fg_color="#356DFF",
            hover_color="#254FD1",
            font=("Arial", 13, "bold"),
            command=self.evaluate_quiz_answer
        ).pack(fill="x", padx=8, pady=(20, 10))

    import cv2
    from PIL import Image, ImageTk

    # (Inside your MLGuideMobileApp class)

    def render_quiz_question(self):
        self.clear_content()

        q_data = self.quiz_questions[self.current_q_idx]
        total_q = len(self.quiz_questions)

        # Header info
        ctk.CTkLabel(
            self.content,
            text=f"{self.selected_role_name.upper()} • QUESTION {self.current_q_idx + 1} OF {total_q}",
            font=("Arial", 11, "bold"),
            text_color="#58C7FF"
        ).pack(anchor="w", pady=(10, 2))

        # --- LOCAL VIDEO CLIP DISPLAY FRAME ---
        video_frame = ctk.CTkFrame(self.content, fg_color="#0A1628", corner_radius=10, height=160)
        video_frame.pack(fill="x", pady=5)
        video_frame.pack_propagate(False)

        self.video_label = ctk.CTkLabel(video_frame, text="")
        self.video_label.pack(expand=True, fill="both")

        # Map role & question index to local video files (adjust paths as needed)
        clip_path = q_data.get("clip_path", "assets/clips/default_scenario.mp4")
        self.play_local_video_frame(clip_path)

        # Question Card
        q_card = ctk.CTkFrame(self.content, fg_color="#142C50", corner_radius=10, border_width=1,
                              border_color="#2676BC")
        q_card.pack(fill="x", pady=5)

        ctk.CTkLabel(
            q_card,
            text=q_data["question"],
            font=("Arial", 11),
            text_color="#E3ECFA",
            wraplength=310,
            justify="left"
        ).pack(anchor="w", padx=12, pady=10)

        self.selected_option_var = ctk.IntVar(value=-1)

        for idx, option_text in enumerate(q_data["options"]):
            rb = ctk.CTkRadioButton(
                self.content,
                text=option_text,
                variable=self.selected_option_var,
                value=idx,
                font=("Arial", 10),
                text_color="#FFFFFF",
                fg_color="#356DFF",
                hover_color="#254FD1"
            )
            rb.pack(anchor="w", padx=8, pady=4)

        ctk.CTkButton(
            self.content,
            text="Confirm Answer  →",
            height=38,
            corner_radius=8,
            fg_color="#356DFF",
            hover_color="#254FD1",
            font=("Arial", 12, "bold"),
            command=self.evaluate_quiz_answer
        ).pack(fill="x", padx=8, pady=(15, 10))

    def play_local_video_frame(self, path):
        """Grabs the first frame or preview thumbnail from the local host video file."""
        try:
            cap = cv2.VideoCapture(path)
            success, frame = cap.read()
            if success:
                # Convert OpenCV BGR to RGB
                frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
                frame = cv2.resize(frame, (310, 150))
                img = Image.fromarray(frame)
                img_tk = ImageTk.PhotoImage(image=img)
                self.video_label.configure(image=img_tk, text="")
                self.video_label.image = img_tk  # Keep a reference
            else:
                self.video_label.configure(text="[ Scenario Preview Clip Unavailable ]", image="")
            cap.release()
        except Exception:
            self.video_label.configure(text="[ Error Loading Local Clip ]", image="")

    def open_history(self):
        self.set_active_nav(self.btn_nav_history)
        self.clear_content()
        ctk.CTkLabel(self.content, text="MATCH HISTORY", font=("Arial", 20, "bold"), text_color="#FFFFFF").pack(anchor="w", pady=(10, 5))
        ctk.CTkLabel(self.content, text="No previous saved analyses found.", font=("Arial", 12), text_color="#A7B9D4").pack(anchor="w", pady=10)


if __name__ == "__main__":
    app = MLGuideMobileApp()
    app.mainloop()
