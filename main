    def open_assessment(self):
        self.set_active_nav(self.btn_nav_assess)
        self.clear_content()

        ctk.CTkLabel(
            self.content, text="CHOOSE YOUR ROLE", font=("Arial", 20, "bold"), text_color="#FFFFFF"
        ).pack(anchor="w", pady=(10, 5))

        ctk.CTkLabel(
            self.content, text="Select a role to test your specialized game sense and tactical decision-making.", font=("Arial", 12), text_color="#A7B9D4", wraplength=320, justify="left"
        ).pack(anchor="w", pady=(0, 15))

        roles = [
            ("🔮 Mid Lane", "Mage / Control", "Focus on wave clearing, fast map rotations, and objective spell synergy."),
            ("💰 Gold Lane", "Marksman / Scaling", "Master spacing, last-hitting, farming tempo, and late-game positioning."),
            ("🛡️ Exp Lane", "Fighter / Sustain", "Manage wave freezing, split-push pressure, and teamfight initiation timing."),
            ("🗡️ Jungle Lane", "Assassin / Core", "Optimize farming efficiency, objective securing with Retribution, and backline picks."),
            ("🤝 Roam Lane", "Tank / Support", "Provide map vision, protect main carries, and control engagement choke points.")
        ]

        for title, subtitle, desc in roles:
            card = ctk.CTkFrame(self.content, corner_radius=12, fg_color="#10213B", border_width=1, border_color="#233D60")
            card.pack(fill="x", pady=6)

            ctk.CTkLabel(card, text=title, font=("Arial", 14, "bold"), text_color="#66D3FF").pack(
                anchor="w", padx=14, pady=(10, 0)
            )
            ctk.CTkLabel(card, text=subtitle, font=("Arial", 10, "bold"), text_color="#58C7FF").pack(
                anchor="w", padx=14, pady=(0, 2)
            )
            ctk.CTkLabel(
                card, text=desc, font=("Arial", 11), text_color="#E3ECFA", wraplength=310, justify="left"
            ).pack(anchor="w", padx=14, pady=(0, 10))

            card.bind("<Button-1>", lambda e, r=title: self.start_role_quiz(r))
            for child in card.winfo_children():
                child.bind("<Button-1>", lambda e, r=title: self.start_role_quiz(r))

